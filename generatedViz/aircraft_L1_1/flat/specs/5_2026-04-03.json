{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "mark": {
    "type": "circle",
    "opacity": 0.8,
    "stroke": "black",
    "strokeWidth": 1
  },
  "encoding": {
    "x": {
      "field": "Age",
      "type": "quantitative",
      "title": "Age (years)"
    },
    "y": {
      "field": "Passenger capacity",
      "type": "quantitative",
      "title": "Passenger Capacity"
    },
    "size": {
      "field": "Mileage",
      "type": "quantitative",
      "title": "Mileage (km)",
      "scale": {
        "range": [
          100,
          1000
        ]
      },
      "legend": {
        "format": "~s"
      }
    },
    "color": {
      "field": "Longest Flight time",
      "type": "quantitative",
      "title": "Longest Flight Time (hrs)",
      "scale": {
        "scheme": "viridis"
      }
    },
    "tooltip": [
      {
        "field": "Aircraft",
        "type": "nominal"
      },
      {
        "field": "Age",
        "type": "quantitative"
      },
      {
        "field": "Passenger capacity",
        "type": "quantitative"
      },
      {
        "field": "Mileage",
        "type": "quantitative",
        "format": ",",
        "title": "Mileage (km)"
      },
      {
        "field": "Longest Flight time",
        "type": "quantitative",
        "title": "Longest Flight Time (hrs)"
      }
    ]
  },
  "data": {
    "url": "data/aircraft.json"
  }
}