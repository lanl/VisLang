{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Aircraft comparison showing relationship between Age, Mileage, Passenger capacity, and Longest Flight time",
  "width": 400,
  "height": 300,
  "mark": "circle",
  "encoding": {
    "x": {
      "field": "Age",
      "type": "quantitative",
      "title": "Age (years)"
    },
    "y": {
      "field": "Mileage",
      "type": "quantitative",
      "title": "Mileage (km)"
    },
    "size": {
      "field": "Passenger capacity",
      "type": "quantitative",
      "title": "Passenger Capacity"
    },
    "color": {
      "field": "Longest Flight time",
      "type": "quantitative",
      "title": "Max Flight Time (hrs)",
      "scale": {
        "scheme": "viridis"
      }
    },
    "tooltip": [
      {
        "field": "Aircraft",
        "type": "nominal"
      },
      {
        "field": "Age",
        "type": "quantitative"
      },
      {
        "field": "Passenger capacity",
        "type": "quantitative"
      },
      {
        "field": "Mileage",
        "type": "quantitative"
      },
      {
        "field": "Longest Flight time",
        "type": "quantitative"
      }
    ]
  },
  "data": {
    "url": "data/aircraft.json"
  }
}