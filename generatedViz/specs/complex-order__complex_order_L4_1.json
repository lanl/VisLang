{
  "$schema": "https://vega.github.io/schema/vegalite/v5.json",
  "transform": [
    {
      "calculate": "datum.orderId || datum.customer.name || datum.items[0].productId",
      "as": "unique_id"
    }
  ],
  "encoding": {
    "x": {
      "field": "payment.method"
    },
    "y": {
      "field": "customer.country"
    },
    "color": {
      "field": "status"
    },
    "detail": {
      "field": "unique_id"
    }
  },
  "mark": {
    "type": "point"
  },
  "data": {
    "url": "data/complex-order.json"
  }
}