{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "transform": [
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "population",
          "as": "total_population"
        }
      ],
      "groupby": [
        "year",
        "sex"
      ]
    },
    {
      "calculate": "datum.sex == 1 ? 'Male' : 'Female'",
      "as": "sex_label"
    }
  ],
  "mark": "line",
  "encoding": {
    "x": {
      "field": "year",
      "type": "temporal",
      "title": "Year"
    },
    "y": {
      "field": "total_population",
      "type": "quantitative",
      "title": "Total Population"
    },
    "color": {
      "field": "sex_label",
      "type": "nominal",
      "title": "Sex"
    }
  },
  "data": {
    "url": "data/population.json"
  }
}