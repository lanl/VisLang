{
  "$schema": "https://vega.github.io/vega-lite/v5.json",
  "transform": [
    {
      "flatten": [
        "employee.projects"
      ],
      "as": [
        "projects"
      ]
    },
    {
      "flatten": [
        "projects.tasks"
      ],
      "as": [
        "tasks"
      ]
    },
    {
      "aggregate": [
        {
          "op": "count",
          "field": "projects.projectId",
          "as": "projectCount"
        }
      ],
      "groupby": [
        "projects.startDate",
        "tasks.status"
      ]
    }
  ],
  "mark": "bar",
  "encoding": {
    "x": {
      "field": "projects.startDate",
      "type": "temporal"
    },
    "y": {
      "field": "projectCount",
      "type": "quantitative"
    },
    "color": {
      "field": "tasks.status",
      "type": "nominal"
    }
  },
  "data": {
    "url": "data/Employee 1 MB 5 Level Formatted.json"
  }
}